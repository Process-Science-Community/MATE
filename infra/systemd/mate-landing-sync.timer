[Unit]
Description=Check origin/main for MATE landing page changes every 5 minutes
Documentation=https://github.com/Process-Science-Community/MATE/blob/main/docs/DEPLOY.md

[Timer]
# Catch the first push shortly after a reboot, then poll.
OnBootSec=2min
OnUnitActiveSec=5min
# Run a missed cycle immediately if the VM was down when it was due.
Persistent=true
Unit=mate-landing-sync.service

[Install]
WantedBy=timers.target
