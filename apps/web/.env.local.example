# Copy to `.env.local` and adjust for your dev setup. The web frontend reads
# these at build time (NEXT_PUBLIC_*) and at startup (the rest).

# Browser → backend. The default works when you run `uv run uvicorn …` on the
# host. If you're running everything via `docker compose up`, set this to
# http://localhost:8000 (host) – the api container exposes 8000 to the host.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side fetch base (RSC, route handlers). Inside docker-compose this is
# `http://api:8000`; on the host it's the same as NEXT_PUBLIC_API_URL.
INTERNAL_API_URL=http://localhost:8000

# Keycloak. The issuer host must be reachable from BOTH the browser and the
# Next server. For host-mode `make dev` either use http://localhost:8080 or add
# `127.0.0.1 keycloak` to /etc/hosts and keep the `keycloak` hostname.
KEYCLOAK_ISSUER=http://keycloak:8080/realms/flows-funds
KEYCLOAK_CLIENT_ID=flows-funds-web
KEYCLOAK_CLIENT_SECRET=flows-funds-web-dev-secret
# Provider buttons (google,microsoft,github) once infra/keycloak/configure-social-idps.sh
# has set them up; empty = none.
KEYCLOAK_SOCIAL_IDPS=

# Host-mode development uses the repository-root `.env`; this file is kept only
# as a compatibility reference for direct Next.js development.
# Local plugin development does not require AUTH_SECRET when DEMO_MODE=true.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Demo login bypass (LOCAL/DEV ONLY). true → the login page auto-signs you in
# as a fixed, non-admin "Demo User" with no Keycloak. Must also be set on the
# API side. NEVER enable in a shared/public deployment.
DEMO_MODE=false
# true → flag the demo session as admin (shows admin UI). Only has effect when
# DEMO_MODE is on, and must also be set on the API side for /admin/* to work.
DEMO_ADMIN=false
